{
  "name": "agent-remote-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/build.mjs --serve",
    "ios:add": "cap add ios",
    "ios:sync": "cap sync ios",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:build": "pwsh -NoProfile -File scripts/build-android.ps1",
    "check:ci": "node scripts/check-ci.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/inappbrowser": "4.1.0",
    "@capacitor/ios": "8.5.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "esbuild": "0.28.2",
    "yaml": "2.9.1"
  }
}
